# Copy to .env.local and fill in. Never commit real values.
# Postgres connection string (Neon, Supabase, Vercel Postgres ...). Optional: the site runs without it,
# but accounts, sync, community, and the admin CMS need it.
DATABASE_URL=
# One-time token that lets the first administrator create the admin account at /admin/setup.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SETUP_TOKEN=
# Optional: enables generated answers in Unveiled AI (otherwise the AI page returns retrieval-only research briefs).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Public base URL (used in sitemap, share links and metadata).
NEXT_PUBLIC_SITE_URL=https://bible-unveiled.vercel.app
